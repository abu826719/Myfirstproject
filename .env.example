# gBrain / Hermes LLM router — copy to `.env` and fill in.
# Names MUST match `api_key_env` in llm_router_config.json.

# Primary — OpenAI Codex (your linked account/credits)
OPENAI_API_KEY=sk-...

# Secondary — Claude (backup when OpenAI quota is exhausted)
ANTHROPIC_API_KEY=sk-ant-...

# Tertiary — Gemini (final fallback)
GEMINI_API_KEY=AIza...

# Optional: point the router at a non-default config file
# LLM_ROUTER_CONFIG=llm_router_config.json
